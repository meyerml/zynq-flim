int prepare_laser_emulator() {

	if((NUM_PIXELS)>pow(2,18)){
		xil_printf("warning: %d pixels cannot be put into laser emulators BRAM, make sure you have BRAM_wraparound set", NUM_PIXELS);
	}


    // Read and write 32-bit words
    void *bram_ptr = BRAM_BASE_ADDR;
    uint32_t word;
    int words_written = 0;

    //while (fread(&word, sizeof(uint32_t), 1, file) == 1) {
    for (int i = 0; i<(NUM_PIXELS); i++){
    	if(i>=32768){
    		xil_printf("thats more pixels than fit in the emulators BRAM. BRAM_Wraparound will have to cover it");
    		break;
    	}
    	word = binary_data[i];
    	uint32_t bram_ptr_neu = (uint32_t*)(bram_ptr + i*4);
        Xil_Out32(bram_ptr_neu, word);
        xil_printf("%d\n\r", i);
        words_written++;
    }

    for (int i = 0; i<(NUM_PIXELS); i++){
    	if(i>=32768){
    		break;
    	}
    	word = binary_data[i];
    	uint32_t read_word = Xil_In32((uint32_t)(bram_ptr + i));
        if(read_word != word){
        	xil_printf("read back %x from pixel %u, expected %x.\n", read_word, i, word);
        }
    }

    //fclose(file);
    xil_printf("Successfully wrote %u words to BRAM\n", (words_written));
    return 0;
}

